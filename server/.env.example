# Copy file này thành file .env (cùng thư mục server) rồi điền giá trị thật
# File .env đã được .gitignore, không bị đẩy lên GitHub

# Link kết nối MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/marketplace-crm

# Chuỗi bí mật để ký token đăng nhập admin (chuỗi ngẫu nhiên, dài, không chia sẻ cho ai)
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
