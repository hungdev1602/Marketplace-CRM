# Copy file này thành file .env (cùng thư mục server) rồi điền giá trị thật
# File .env đã được .gitignore, không bị đẩy lên GitHub

# Link kết nối MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/marketplace-crm

# Chuỗi bí mật để ký token đăng nhập (admin và tài khoản khách hàng), chuỗi ngẫu nhiên, dài, không chia sẻ cho ai
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Địa chỉ website (không có dấu / ở cuối), dùng để tạo link trong email quên mật khẩu
# Chạy trên máy: http://localhost:3000 — Lên server thật: https://ten-mien-cua-ban.ru
SITE_URL=http://localhost:3000

# Gửi email (quên mật khẩu). Để trống SMTP_HOST thì không gửi email thật,
# link đặt lại mật khẩu được in ra cửa sổ terminal đang chạy server (dùng để thử trên máy)
# - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS là "Mật khẩu ứng dụng" 16 ký tự (không phải mật khẩu Gmail)
# - Yandex: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_PASS là "Пароль приложения"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Tên và email người gửi hiển thị trong hộp thư của khách, ví dụ: SFoodie <email-cua-ban@gmail.com>
# Để trống thì dùng "SFoodie <SMTP_USER>". Gmail, Yandex chỉ cho gửi bằng đúng email đã đăng nhập ở SMTP_USER
SMTP_FROM=

# ===== Giao hàng: ApiShip (https://apiship.ru) =====
# APISHIP_TEST=true: dùng máy chủ thử nghiệm của ApiShip (http://api.dev.apiship.ru), không tạo vận đơn thật
#   Máy chủ thử nghiệm dùng chung tài khoản: APISHIP_LOGIN=test, APISHIP_PASSWORD=test
# APISHIP_TEST=false: dùng tài khoản thật (login + mật khẩu đăng nhập tài khoản ApiShip của bạn)
APISHIP_TEST=true
APISHIP_LOGIN=test
APISHIP_PASSWORD=test

# ===== Thanh toán online: YooKassa (https://yookassa.ru) =====
# Lấy trong trang YooKassa: Интеграция => Ключи API
# - YOOKASSA_SHOP_ID: shopId (số), YOOKASSA_SECRET_KEY: Секретный ключ
# - Cửa hàng thử nghiệm (Тестовый магазин) có khoá bắt đầu bằng "test_", thanh toán bằng thẻ thử, không mất tiền thật
# Để trống 2 dòng này thì khách không thanh toán được (trừ khi bật PAYMENT_TEST_MODE bên dưới)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Thanh toán giả để thử trên máy khi chưa có tài khoản YooKassa: true là bật
# Bấm "Оформить заказ" sẽ mở trang thanh toán giả có nút "Оплатить" / "Отменить", không mất tiền
# CHỈ dùng khi thử trên máy, KHÔNG bật trên server thật. Đã điền YooKassa ở trên thì dòng này không có tác dụng
PAYMENT_TEST_MODE=false

# Email nhận thông báo khi có đơn hàng mới được thanh toán (để trống là không gửi)
ORDER_NOTIFY_EMAIL=
