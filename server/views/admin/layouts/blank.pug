doctype html
html(
  data-bs-theme="dark" 
  data-startbar="dark" 
  dir="ltr" 
  lang="en"
  )
  head
    script.
      const pathAdmin = "#{pathAdmin}" // "admin"
    meta(charset="utf-8")
    title #{pageTitle}
    meta(
      content="width=device-width, initial-scale=1, shrink-to-fit=no" 
      name="viewport"
      )
    meta(
      name="description" 
      content="Premium Multipurpose Admin & Dashboard Template"
      )
    meta(
      name="author" 
      content=""
      )
    meta(
      content="IE=edge" 
      http-equiv="X-UA-Compatible"
      )
    // Uppy (để sẵn trong server, không tải từ CDN)
    link(
      rel="stylesheet" 
      href="/admin/assets/libs/uppy/v4.18.2/uppy.min.css"
    )
    // App favicon (?v=2 để trình duyệt tải favicon mới thay cho favicon cũ đã lưu)
    link(
      rel="icon"
      href="/admin/assets/images/favicon.ico?v=2"
      )
    link(
      rel="apple-touch-icon"
      href="/admin/assets/images/apple-touch-icon.png?v=2"
      )
    // notyf
    link(
      rel="stylesheet", 
      href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css"
    )
    // sweetalert2
    link(
      rel="stylesheet", 
      href="https://cdn.jsdelivr.net/npm/sweetalert2@11.23.0/dist/sweetalert2.min.css"
    )
    // App css
    link(
      type="text/css" 
      rel="stylesheet" 
      href="/admin/assets/css/bootstrap.min.css"
      )
    link(
      type="text/css" 
      rel="stylesheet" 
      href="/admin/assets/css/icons.min.css"
      )
    link(
      type="text/css" 
      rel="stylesheet" 
      href="/admin/assets/css/app.min.css"
      )
    link(
      type="text/css" 
      rel="stylesheet" 
      href="/admin/assets/css/main.css"
      )
  // Top Bar Start
  body
    block main
    // Javascript
    // vendor js
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js") 
    script(src="https://unpkg.com/just-validate@latest/dist/just-validate.production.min.js") 
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11.23.0/dist/sweetalert2.all.min.js") 
    script(src="/admin/assets/libs/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/admin/assets/libs/simplebar/simplebar.min.js")
    block script
    script(src="/admin/assets/js/app.js")
    script(src="/admin/assets/js/main.js")
    script(src="/admin/assets/js/uppy.js" type="module")
  // end body