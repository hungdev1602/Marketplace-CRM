.startbar.d-print-none
  // start brand
  .brand
    a.logo(href=`/${pathAdmin}/dashboard`)
      //- Icon vuông: hiện khi menu thu gọn
      img.logo-sm(
        alt="SFoodie"
        src="/admin/assets/images/sfoodie-icon.png"
        )
      //- Logo ngang: hiện khi menu mở rộng
      img.logo-lg(
        alt="SFoodie"
        src="/admin/assets/images/sfoodie-logo.png"
        )
  // end brand
  // start startbar-menu
  .startbar-menu
    #startbarCollapse.startbar-collapse(data-simplebar="")
      .d-flex.align-items-start.flex-column.w-100
        // Navigation
        ul.navbar-nav.mb-auto.w-100
          li.menu-label.pt-0.mt-0
            //
              <small class="label-border">
                <div class="border_left hidden-xs"></div>
                <div class="border_right"></div>
                </small>
            span Main Menu
          if permissions.includes("dashboard")
            li.nav-item
              a.nav-link(
                href=`/${pathAdmin}/dashboard`
                )
                i.iconoir-home-simple.menu-icon
                span Trang tổng quan
          // end nav-item
          if ["product-create", "product-list", "product-category", "product-import"].some(item => permissions.includes(item))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarProduct"
                aria-expanded="false"
                role="button"
                data-bs-toggle="collapse"
                href="#sidebarProduct"
                )
                i.iconoir-shopping-bag.menu-icon
                span Sản phẩm
              #sidebarProduct.collapse
                ul.nav.flex-column
                  if permissions.includes("product-create")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/product/create`) Tạo sản phẩm
                  // end nav-item
                  if permissions.includes("product-list")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/product/list`) Danh sách sản phẩm
                  // end nav-item
                  if permissions.includes("product-category")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/product/category`) Danh mục sản phẩm
                  // end nav-item
                  if permissions.includes("product-import")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/product/import`) Nhập sản phẩm từ Excel
                  // end nav-item
                // end nav
              // end sidebarProduct
          // end nav-item
          if ["coupon-create", "coupon-list"].some(item => permissions.includes(item))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarCoupon"
                aria-expanded="false"
                role="button"
                data-bs-toggle="collapse"
                href="#sidebarCoupon"
                )
                i.iconoir-percentage-circle.menu-icon
                span Mã giảm giá
              #sidebarCoupon.collapse
                ul.nav.flex-column
                  if permissions.includes("coupon-create")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/coupon/create`) Tạo mã giảm giá
                  // end nav-item
                  if permissions.includes("coupon-list")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/coupon/list`) Danh sách mã giảm giá
                  // end nav-item
                // end nav
              // end sidebarCoupon
          // end nav-item
          if ["article-create", "article-list", "article-category"].some(item => permissions.includes(item))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarApplications" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarArticle"
                )
                i.iconoir-journal-page.menu-icon
                span Bài viết
              #sidebarArticle.collapse
                ul.nav.flex-column
                  if permissions.includes("article-create")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/article/create`) Tạo bài viết
                  // end nav-item
                  if permissions.includes("article-list")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/article/list`) Danh sách bài viết
                  // end nav-item
                  if permissions.includes("article-category")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/article/category`) Danh mục bài viết
                  // end nav-item
                // end nav
              // end sidebarArticle
          // end nav-item
          if ["role-create", "role-list"].some(item => permissions.includes(item))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarRole" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarRole"
                )
                i.iconoir-user-badge-check.menu-icon
                span Nhóm quyền
              #sidebarRole.collapse
                ul.nav.flex-column
                  if permissions.includes("role-create")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/role/create`) Tạo nhóm quyền
                  // end nav-item
                  if permissions.includes("role-list")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/role/list`) Danh sách nhóm quyền
                  // end nav-item
          if ["account-admin-create", "account-admin-list"].some(item => permissions.includes(item))
            li.nav-item
              a.nav-link(
                aria-controls="sidebarAccountAdmin" 
                aria-expanded="false" 
                role="button" 
                data-bs-toggle="collapse" 
                href="#sidebarAccountAdmin"
                )
                i.iconoir-user-crown.menu-icon
                span Tài khoản quản trị
              #sidebarAccountAdmin.collapse
                ul.nav.flex-column
                  if permissions.includes("account-admin-create")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/account-admin/create`) Tạo tài khoản
                  // end nav-item
                  if permissions.includes("account-admin-list")
                    li.nav-item
                      a.nav-link(href=`/${pathAdmin}/account-admin/list`) Danh sách tài khoản
                  // end nav-item
          if permissions.includes("file-manager")
            li.nav-item
              a.nav-link(
                href=`/${pathAdmin}/file-manager/iframe`
                )
                i.iconoir-page-star.menu-icon
                span Quản lý file
          // end nav-item
          //- Nhật ký hoạt động: chỉ Super Admin xem được
          if account.isSuperAdmin
            li.nav-item
              a.nav-link(
                href=`/${pathAdmin}/activity-log/list`
                )
                i.iconoir-clock-rotate-right.menu-icon
                span Nhật ký hoạt động
          // end nav-item

.startbar-overlay.d-print-none