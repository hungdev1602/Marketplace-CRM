#modalFileManager.modal.fade(
  aria-hidden="true" 
  tabindex="-1"
  )
  .modal-dialog.modal-xl
    .modal-content
      .modal-header
        h1.modal-title.fs-5 Chọn File
        button.btn-close(
          aria-label="Close" 
          data-bs-dismiss="modal" 
          type="button"
          )
      .modal-body
        //- Dùng data-src: iframe chỉ được tải khi mở modal (xử lý trong main.js)
        iframe(
          data-src=`/${pathAdmin}/file-manager`, 
          frameborder="0"
          style="width: 100%; height: 76vh;"
        ) 