extends ../layouts/default.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            // end col
            .col-auto
              a.btn.btn-primary(
                href=`/${pathAdmin}/coupon/list`
                )
                i.fa-solid.fa-arrow-left.me-1
                | Quay lại danh sách
            // end col
          // end row
        // end card-header
        //- Table
        .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th STT
                  th Mã giảm giá
                  th Mức giảm
                  th.text-center Đã dùng
                  th Thời gian xoá (giờ Moscow)
                  th.text-end Hành động
              tbody
                each item, index in couponList
                  tr
                    td #{index + 1}
                    td
                      div.fw-bold.font-monospace #{item.code}
                      div.small #{item.name}
                    td.text-nowrap #{item.discountText}
                    td.text-center #{item.usedCount}
                    td.text-nowrap #{item.deletedAtFormat}
                    td.text-end.text-nowrap
                      a(href="javascript:;"
                        button-api
                        data-method="PATCH"
                        data-api=`/${pathAdmin}/coupon/undo/${item.id}`
                        style="margin: 5px"
                        title="Khôi phục"
                      )
                        <i class="fa-solid fa-rotate-left text-secondary" style="font-size: 1.2rem;"></i>
                      a(
                        href="javascript:;"
                        button-api
                        data-method="DELETE"
                        data-api=`/${pathAdmin}/coupon/delete-permanently/${item.id}`
                        style="margin: 5px"
                        title="Xoá vĩnh viễn"
                      )
                        <i class="fa-solid fa-trash text-danger" style="font-size: 1.2rem;"></i>
                else
                  tr
                    td.text-center(colspan="6") Thùng rác trống

    // end col
  // end row
