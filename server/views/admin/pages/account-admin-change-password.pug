extends ../layouts/default.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="accountAdminChangePasswordForm")
        .row
          .col-md-12.col-lg-12.d-none
            .mb-3
              label.form-label(for="id") Id *
              input.form-control(id="id" type="text" name="id" value=accountDetail.id)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="fullName") Họ tên
              input.form-control(id="fullName" type="text" value=accountDetail.fullName disabled)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="email") Email
              input.form-control(id="email" type="email" value=accountDetail.email disabled)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="password") Mật khẩu mới *
              input.form-control(id="password" type="password" name="password" autocomplete="new-password")
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="confirmPassword") Xác nhận mật khẩu mới *
              input.form-control(id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password")
        button.btn.btn-primary(type="submit") Đổi mật khẩu
        a.btn.btn-danger.ms-1(href=`/${pathAdmin}/account-admin/list`) Hủy