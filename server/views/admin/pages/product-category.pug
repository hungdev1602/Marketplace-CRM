extends ../layouts/default.pug
include ../mixins/pagination.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            // end col
            .col-auto
              if permissions.includes("product-category-trash")
                a.btn.btn-danger.me-1(
                  href=`/${pathAdmin}/product/category/trash`
                  )
                  i.fa-solid.fa-trash.me-1
                  | Thùng rác
              if permissions.includes("product-category-create")
                a.btn.btn-primary(
                  href=`/${pathAdmin}/product/category/create`
                  )
                  i.fa-solid.fa-plus.me-1
                  | Tạo danh mục
            // end col
          // end row
        // end card-header
        // Search
        .card-body.pt-0
          .row
            .col-lg-12
              include ../partials/form-search.pug
        // Table
        .table-responsive
          table.table.table-striped.mb-0
            thead.table-light
              tr
                th STT
                th Ảnh
                th Tên danh mục
                th Danh mục cha
                th.text-center Số sản phẩm
                th.text-center Vị trí
                th Trạng thái
                th.text-end Hành động
            tbody
              if(allCategory.length > 0)
                each item, index in allCategory
                  tr
                    td #{pagination.skip + index + 1}
                    td
                      if(item.avatar)
                        img(
                          src=`${domainFileManager}${item.avatar}`
                          class="thumb-md me-1 d-inline rounded"
                        )
                    td
                      div.fw-medium #{item.name}
                      if(item.nameRu)
                        small.text-muted #{item.nameRu}
                    td #{item.parentName}
                    td.text-center #{item.productCount}
                    td.text-center #{item.position}
                    td
                      if (item.status == "active")
                        span.badge.bg-success Hoạt động
                      else if (item.status == "inactive")
                        span.badge.bg-danger Tạm dừng
                    td.text-end.text-nowrap
                      if permissions.includes("product-category-edit")
                        a(
                          href=`/${pathAdmin}/product/category/edit/${item.id}`
                          style="margin: 5px"
                          title="Chỉnh sửa"
                        )
                          <i class="fa-solid fa-pen-to-square text-secondary" style="font-size: 1.2rem;"></i>
                      if permissions.includes("product-category-delete")
                        a(
                          href="javascript:;"
                          button-api
                          data-method="PATCH"
                          data-api=`/${pathAdmin}/product/category/delete/${item.id}`
                          style="margin: 5px"
                          title="Xoá"
                        )
                          <i class="fa-solid fa-trash text-secondary" style="font-size: 1.2rem;"></i>
              else
                tr
                  td(colspan=8 class="text-center") Không tìm thấy dữ liệu
          +pagination(pagination, page)
    // end col
  // end row
