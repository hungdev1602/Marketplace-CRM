extends ../layouts/default.pug

//- Ô số liệu: biểu tượng, tên, con số, dòng mô tả; có link thì bấm vào cả ô để xem chi tiết
mixin stat-card(label, value, note, icon, iconColor, link)
  .card.dashboard-stat-card.flex-fill
    .card-body
      .d-flex.align-items-center
        .flex-grow-1
          p.text-muted.mb-1 #{label}
          h3.fw-bold.mb-1 #{value}
          if note
            p.small.text-muted.mb-0 #{note}
        .d-flex.justify-content-center.align-items-center.thumb-lg.rounded-circle.bg-light.ms-2
          i(class=`${icon} fs-4 ${iconColor}`)
      if link
        a.stretched-link(href=link aria-label=label)

block main
  //- Tiêu đề, thời gian lấy số liệu, nút thao tác nhanh
  .row.align-items-center.mb-3
    .col
      h4.mb-1 #{pageTitle}
      p.text-muted.small.mb-0 Số liệu lúc #{updatedAt} (giờ Moscow). Tải lại trang để cập nhật.
    .col-auto.mt-2.mt-md-0
      if permissions.includes("product-create")
        a.btn.btn-primary.btn-sm.me-1.mb-1(href=`/${pathAdmin}/product/create`)
          i.fa-solid.fa-plus.me-1
          | Tạo sản phẩm
      if permissions.includes("product-import")
        a.btn.btn-outline-success.btn-sm.me-1.mb-1(href=`/${pathAdmin}/product/import`)
          i.fa-solid.fa-file-import.me-1
          | Nhập Excel
      if permissions.includes("coupon-create")
        a.btn.btn-outline-primary.btn-sm.me-1.mb-1(href=`/${pathAdmin}/coupon/create`)
          i.fa-solid.fa-ticket.me-1
          | Tạo mã giảm giá
      if permissions.includes("article-create")
        a.btn.btn-outline-secondary.btn-sm.mb-1(href=`/${pathAdmin}/article/create`)
          i.fa-solid.fa-pen.me-1
          | Viết bài

  if !productStats && !couponStats && !articleStats && !activityList
    .card
      .card-body.text-center.text-muted.py-5
        | Tài khoản chưa được cấp quyền xem chức năng nào để hiện số liệu. Vui lòng liên hệ quản trị viên.

  //- ===== Sản phẩm =====
  if productStats
    .row
      .col-md-6.col-xl-3.d-flex
        +stat-card(
          "Sản phẩm",
          formatNumber(productStats.totalCount),
          `${formatNumber(productStats.activeCount)} đang bán · ${formatNumber(productStats.inactiveCount)} ngừng bán`,
          "iconoir-shopping-bag",
          "text-primary",
          `/${pathAdmin}/product/list`
        )
      .col-md-6.col-xl-3.d-flex
        +stat-card(
          "Hết hàng",
          formatNumber(productStats.outOfStockCount),
          "Sản phẩm đang bán, tồn kho bằng 0",
          "iconoir-warning-triangle",
          productStats.outOfStockCount > 0 ? "text-danger" : "text-success",
          `/${pathAdmin}/product/list?status=active&stock=out`
        )
      .col-md-6.col-xl-3.d-flex
        +stat-card(
          "Sắp hết hàng",
          formatNumber(productStats.lowStockCount),
          `Sản phẩm đang bán, tồn kho từ 1 đến ${lowStockThreshold}`,
          "iconoir-box-iso",
          productStats.lowStockCount > 0 ? "text-warning" : "text-success",
          `/${pathAdmin}/product/list?status=active&stock=low`
        )
      .col-md-6.col-xl-3.d-flex
        +stat-card(
          "Giá trị hàng tồn kho (giá nhập)",
          productStats.stockCostValueFormat,
          `Theo giá bán: ${productStats.stockPriceValueFormat}` + (productStats.missingCostPriceCount ? ` · ${formatNumber(productStats.missingCostPriceCount)} sản phẩm còn hàng chưa nhập giá nhập` : ""),
          "iconoir-coins",
          "text-info",
          ""
        )

    .row
      .col-lg-5.d-flex
        .card.flex-fill
          .card-header
            h4.card-title Sản phẩm theo danh mục
            p.small.text-muted.mb-0 Tính cả danh mục con, 1 sản phẩm có thể thuộc nhiều danh mục
          .card-body.pt-0
            div(dashboard-chart data-chart=JSON.stringify(productStats.categoryChart))
      .col-lg-4.d-flex
        .card.flex-fill
          .card-header
            h4.card-title Sản phẩm theo xuất xứ
          .card-body.pt-0
            div(dashboard-chart data-chart=JSON.stringify(productStats.originChart))
      .col-lg-3.d-flex
        .card.flex-fill
          .card-header
            h4.card-title Điều kiện bảo quản
            p.small.text-muted.mb-0 Hàng mát, đông lạnh cần xe / hộp giữ lạnh khi giao
          .card-body.pt-0
            ul.list-group.list-group-flush
              each item in productStats.storageList
                li.list-group-item.bg-transparent.d-flex.justify-content-between.align-items-center.px-0
                  span(class=`badge ${item.color} text-wrap text-start`) #{item.name}
                  a.fw-semibold(href=`/${pathAdmin}/product/list?storageType=${item.id}`) #{formatNumber(item.count)}
              if productStats.noStorageCount > 0
                li.list-group-item.bg-transparent.d-flex.justify-content-between.align-items-center.px-0
                  span.text-muted Chưa chọn
                  span.fw-semibold #{formatNumber(productStats.noStorageCount)}

    .row
      .col-lg-7.d-flex
        .card.flex-fill
          .card-header
            .row.align-items-center
              .col
                h4.card-title Sản phẩm cần nhập thêm hàng
                p.small.text-muted.mb-0 Sản phẩm đang bán có tồn kho từ #{lowStockThreshold} trở xuống, ít nhất trước
              .col-auto
                a.btn.btn-sm.btn-light(href=`/${pathAdmin}/product/list?status=active&sort=stock-asc`) Xem tất cả
          .card-body.pt-0
            if productStats.lowStockList.length > 0
              .table-responsive
                table.table.mb-0
                  thead.table-light
                    tr
                      th Sản phẩm
                      th.text-center Tồn kho
                      th.text-end
                  tbody
                    each item in productStats.lowStockList
                      tr
                        td
                          .d-flex.align-items-center
                            if item.avatar
                              img.thumb-md.rounded.me-2(src=`${domainFileManager}${item.avatar}` alt="" style="object-fit: contain;")
                            div
                              div.fw-medium #{item.name}
                              if item.sku
                                div.small.text-muted SKU: #{item.sku}
                        td.text-center.text-nowrap
                          if !(item.stock > 0)
                            span.badge.bg-danger Hết hàng
                          else
                            span.badge.bg-warning #{item.stock}
                            if item.unitName
                              span.small.text-muted  #{item.unitName}
                        td.text-end
                          if permissions.includes("product-edit")
                            a(href=`/${pathAdmin}/product/edit/${item.id}` title="Chỉnh sửa")
                              i.fa-solid.fa-pen-to-square.text-secondary.fs-5
            else
              p.text-center.text-success.my-4
                i.fa-solid.fa-circle-check.me-1
                | Tất cả sản phẩm đang bán đều đủ hàng
      .col-lg-5.d-flex
        .card.flex-fill
          .card-header
            h4.card-title Thông tin sản phẩm còn thiếu
            p.small.text-muted.mb-0 Nhãn hàng nhập khẩu tại Nga cần tên tiếng Nga, thành phần, hạn sử dụng, nhà nhập khẩu, chứng nhận ЕАЭС. Bấm vào số để xem sản phẩm.
          .card-body.pt-0
            ul.list-group.list-group-flush
              each item in productStats.missingInfoList
                li.list-group-item.bg-transparent.d-flex.justify-content-between.align-items-center.px-0
                  span #{item.name}
                  if item.count > 0
                    a.badge.bg-warning-subtle.text-warning.fs-6(href=`/${pathAdmin}/product/list?missing=${item.id}` title="Xem các sản phẩm còn thiếu") Thiếu #{formatNumber(item.count)}
                  else
                    span.text-success(title="Đã đủ")
                      i.fa-solid.fa-circle-check

  //- ===== Mã giảm giá, bài viết =====
  if couponStats || articleStats
    .row
      if couponStats
        div(class=articleStats ? "col-lg-8 d-flex" : "col-12 d-flex")
          .card.flex-fill
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Mã giảm giá
                .col-auto
                  a.btn.btn-sm.btn-light(href=`/${pathAdmin}/coupon/list`) Xem tất cả
            .card-body.pt-0
              .row.g-2.mb-3
                each item in couponStats.statusList
                  .col
                    a.d-block.border.rounded.text-center.p-2.h-100(href=`/${pathAdmin}/coupon/list?status=${item.id}`)
                      div.fs-4.fw-bold.text-body #{formatNumber(item.count)}
                      span(class=`badge ${item.color}`) #{item.name}
              h6.mb-2 Sắp hết hạn trong 7 ngày
              if couponStats.endingSoonList.length > 0
                .table-responsive
                  table.table.mb-0
                    tbody
                      each item in couponStats.endingSoonList
                        tr
                          td.ps-0
                            span.fw-bold.font-monospace #{item.code}
                            div.small.text-muted #{item.name}
                          td #{item.discountText}
                          td.text-end.text-nowrap.pe-0
                            div #{item.endAtFormat}
                            span.badge.bg-warning-subtle.text-warning #{item.timeLeft}
              else
                p.small.text-muted.mb-0 Không có mã nào đang chạy sắp hết hạn.
      if articleStats
        div(class=couponStats ? "col-lg-4 d-flex" : "col-12 d-flex")
          .card.flex-fill
            .card-header
              .row.align-items-center
                .col
                  h4.card-title Bài viết
                .col-auto
                  a.btn.btn-sm.btn-light(href=`/${pathAdmin}/article/list`) Xem tất cả
            .card-body.pt-0
              ul.list-group.list-group-flush
                li.list-group-item.bg-transparent.d-flex.justify-content-between.px-0
                  span
                    span.badge.bg-success.me-1 Đã xuất bản
                  span.fw-semibold #{formatNumber(articleStats.publishedCount)}
                li.list-group-item.bg-transparent.d-flex.justify-content-between.px-0
                  span
                    span.badge.bg-danger.me-1 Bản nháp
                  span.fw-semibold #{formatNumber(articleStats.draftCount)}
                li.list-group-item.bg-transparent.d-flex.justify-content-between.px-0
                  span
                    span.badge.bg-dark.border.me-1 Đã lưu trữ
                  span.fw-semibold #{formatNumber(articleStats.archivedCount)}
                li.list-group-item.bg-transparent.d-flex.justify-content-between.px-0
                  span.fw-medium Tổng
                  span.fw-bold #{formatNumber(articleStats.totalCount)}

  //- ===== Hoạt động gần đây (chỉ Super Admin) =====
  if activityList
    .card
      .card-header
        .row.align-items-center
          .col
            h4.card-title Hoạt động gần đây
          .col-auto
            a.btn.btn-sm.btn-light(href=`/${pathAdmin}/activity-log/list`) Xem nhật ký
      .card-body.pt-0
        if activityList.length > 0
          .table-responsive
            table.table.mb-0
              tbody
                each item in activityList
                  tr
                    td.text-nowrap.text-muted.small.ps-0 #{item.createdAtFormat}
                    td.text-nowrap #{item.accountFullName}
                    td
                      span(class=`badge ${item.actionColor}`) #{item.actionName}
                    td(style="min-width: 250px;") #{item.description}
        else
          p.small.text-muted.mb-0 Chưa có hoạt động nào.

block script
  script(src="/admin/assets/libs/apexcharts/apexcharts.min.js")
