extends ../layouts/default.pug
include ../mixins/form-field.pug

block main
  section(class="sf-section sf-section-first sf-auth-page")
    .container
      div(class="sf-auth sf-auth-single")
        div(class="sf-auth-card")
          if isValid
            span(class="sf-auth-icon")
              i.fas.fa-key
            h1 #{t("resetPasswordTitle")}
            p(class="sf-auth-sub") #{t("resetPasswordSub")} #[b #{email}]
            //- Đặt mật khẩu xong thì đăng nhập luôn, chuyển về trang chủ
            form(
              action="/account/reset-password"
              method="POST"
              account-form
              novalidate
              )
              input(
                type="hidden"
                name="token"
                value=token
                )
              //- Ô email ẩn (không gửi lên server): để trình duyệt lưu mật khẩu mới đúng tài khoản
              input(
                type="email"
                value=email
                autocomplete="username"
                hidden
                readonly
                )
              +formField("password", t("newPassword"), "password", { autocomplete: "new-password", maxlength: 72, hint: t("passwordHint") })
              +formField("confirmPassword", t("confirmPassword"), "password", { autocomplete: "new-password", maxlength: 72 })
              +formMessage()
              button(
                type="submit"
                class="sf-btn sf-btn-primary sf-auth-submit"
                ) #{t("saveNewPassword")}
          else
            //- Link sai, hết hạn, đã dùng hoặc đã có link mới hơn
            span(class="sf-auth-icon is-warning")
              i.fas.fa-unlink
            h1 #{t("resetLinkInvalidTitle")}
            p(class="sf-auth-sub") #{t("resetLinkInvalidText")}
            a(
              href="/account/forgot-password"
              class="sf-btn sf-btn-primary sf-auth-submit"
              ) #{t("requestNewLink")}
            p(class="sf-auth-switch")
              | #{t("rememberedPassword")}
              a(href="/account/login") #{t("loginAction")}
