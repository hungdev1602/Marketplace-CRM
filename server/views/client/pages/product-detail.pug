extends ../layouts/default.pug
include ../mixins/product-card.pug
include ../mixins/rating-stars.pug

//- 1 dòng thông tin (tên: giá trị), giá trị trống thì không hiện
mixin infoRow(label, value)
  if value
    tr
      th #{label}
      td #{value}

block main
  - const inStock = product.stock > 0
  - const otherName = lang == "ru" ? product.name : product.nameRu
  - const originName = product.origin ? tOption(productOptions.originList, product.origin) : ""
  - const unitName = product.unit ? tOption(productOptions.unitList, product.unit) : ""
  - const storageName = product.storageType ? tOption(productOptions.storageList, product.storageType) : ""
  - const netWeightText = product.netWeight ? `${formatNumber(product.netWeight)} ${tOption(productOptions.netWeightUnitList, product.netWeightUnit)}` : ""
  - const shelfLifeText = product.shelfLife && shelfLifeKey ? tCount(product.shelfLife, shelfLifeKey) : ""
  - const allergenList = (product.allergens || []).map(id => tOption(productOptions.allergenList, id)).filter(Boolean)
  - const dietTagList = (product.dietTags || []).map(id => tOption(productOptions.dietTagList, id)).filter(Boolean)
  - const hasComposition = product.ingredients || allergenList.length > 0 || hasNutrition
  - const hasStorage = storageName || product.storageNote || shelfLifeText || product.usageInstructions
  - const hasInfo = product.manufacturer || product.importer || product.certificateNumber || product.barcode || product.markingRequired

  //- Dữ liệu có cấu trúc cho Google / Yandex (giá, còn hàng, số sao)
  script(type="application/ld+json") !{structuredDataJson}

  //- Đường dẫn (breadcrumb)
  div(class="sf-breadcrumb-bar")
    .container
      ol(class="sf-breadcrumb")
        li
          a(href="/")
            i.fas.fa-home
            | #{t("home")}
        li
          a(href="/products") #{t("products")}
        each item in categoryPath
          li
            a(href=`/category/${item.slug}`) #{tName(item)}
        li
          span #{productName}

  section(class="sf-product-detail")
    .container
      .row.g-4.g-xl-5
        //- Ảnh sản phẩm
        .col-lg-6
          div(class="sf-gallery")
            //- File đầu tiên là video thì hiện video (tự phát, tắt tiếng), không thì hiện ảnh
            //- main.js đổi giữa ảnh / video khi bấm vào danh sách nhỏ bên dưới
            - const firstMedia = mediaList[0]
            - const isFirstVideo = Boolean(firstMedia && firstMedia.isVideo)
            div(class="sf-gallery-main")
              video(
                class="sf-gallery-video"
                src=isFirstVideo ? mediaUrl(firstMedia.path) : false
                poster=product.cardImage ? mediaUrl(product.cardImage) : false
                controls
                muted
                autoplay=isFirstVideo
                loop
                playsinline
                preload="metadata"
                hidden=!isFirstVideo
                gallery-main-video
                )
              img(
                src=mediaUrl(isFirstVideo ? product.cardImage : (firstMedia && firstMedia.path))
                alt=productName
                hidden=isFirstVideo
                gallery-main-image
                )
              ul(class="sf-badges")
                if product.discountPercent
                  li(class="sf-badge sf-badge-sale") −#{product.discountPercent}%
                if product.newArrival
                  li(class="sf-badge sf-badge-new") #{t("badgeNew")}
                if product.featured
                  li(class="sf-badge sf-badge-hit") #{t("badgeHit")}
            if mediaList.length > 1
              div(class="sf-gallery-thumbs")
                each media, index in mediaList
                  button(
                    type="button"
                    class=index == 0 ? "active" : ""
                    gallery-thumb=mediaUrl(media.path)
                    gallery-type=media.isVideo ? "video" : "image"
                    aria-label=`${productName} ${index + 1}`
                    )
                    if media.isVideo
                      //- Ảnh nhỏ của video: khung hình ở giây 0.1 của video + nút ▶
                      video(
                        src=`${mediaUrl(media.path)}#t=0.1`
                        muted
                        playsinline
                        preload="metadata"
                        tabindex="-1"
                        aria-hidden="true"
                        )
                      span(class="sf-thumb-play")
                        i.fas.fa-play
                    else
                      img(
                        src=mediaUrl(media.path)
                        alt=""
                        loading="lazy"
                        )

        //- Thông tin chính
        .col-lg-6
          div(class="sf-product-info")
            if product.brand || originName
              p(class="sf-product-info-brand")
                if product.brand
                  span #{product.brand}
                if originName && product.origin != "other"
                  span
                    i.fas.fa-globe-asia
                    | #{originName}
            h1 #{productName}
            if otherName && otherName != productName
              p(class="sf-product-subname") #{otherName}

            //- Số sao, số lượt đánh giá: bấm để xuống phần đánh giá
            a(
              href="#reviews"
              class="sf-product-rating"
              )
              if product.ratingCount > 0
                +ratingStars(product.rating)
                b #{formatNumber(product.rating)}
                span #{tCount(product.ratingCount, "ratingCount")}
              else
                +ratingStars(0)
                span #{t("reviewsNone")}

            div(class="sf-stock")
              if !inStock
                span(class="sf-stock-out")
                  i.fas.fa-times-circle
                  | #{t("outOfStock")}
              else if product.isLowStock
                span(class="sf-stock-low")
                  i.fas.fa-exclamation-circle
                  | #{t("lowStock")}
              else
                span(class="sf-stock-in")
                  i.fas.fa-check-circle
                  | #{t("inStock")}

            div(class="sf-detail-price")
              span(class="sf-price") #{product.priceFormat}
              if unitName
                span(class="sf-price-unit") / #{unitName.toLowerCase()}
              if product.discountPercent
                del #{product.priceOldFormat}
                span(class="sf-saving") #{t("youSave")} #{product.savingFormat}

            //- Thêm vào giỏ hàng, yêu thích
            div(class="sf-buy-box")
              +cartControl(product, { large: true })
              +wishlistButton(product, true)

            if product.description
              div(class="sf-product-short sf-content") !{product.description}

            ul(class="sf-fact-list")
              if netWeightText
                li
                  i.fas.fa-weight-hanging
                  span #{t("netWeight")}
                  b #{netWeightText}
              if storageName
                li
                  i(class=product.storageType == "frozen" ? "fas fa-snowflake" : (product.storageType == "chilled" ? "fas fa-thermometer-quarter" : "fas fa-box"))
                  span #{t("storage")}
                  b #{storageName}
              if shelfLifeText
                li
                  i.fas.fa-calendar-alt
                  span #{t("shelfLife")}
                  b #{shelfLifeText}
              if product.sku
                li
                  i.fas.fa-hashtag
                  span #{t("sku")}
                  b #{product.sku}

            if dietTagList.length > 0
              div(class="sf-chip-list")
                each tag in dietTagList
                  span(class="sf-chip sf-chip-static") #{tag}

            if productCategoryList.length > 0
              p(class="sf-product-categories")
                span #{t("categories")}:
                each item, index in productCategoryList
                  a(href=`/category/${item.slug}`) #{tName(item)}

      //- Thông tin chi tiết (các tab)
      div(class="sf-product-tabs")
        ul.nav.nav-tabs(role="tablist")
          li.nav-item(role="presentation")
            button#tab-description-btn.nav-link.active(
              data-bs-toggle="tab"
              data-bs-target="#tab-description"
              type="button"
              role="tab"
              aria-controls="tab-description"
              aria-selected="true"
              ) #{t("tabDescription")}
          if hasComposition
            li.nav-item(role="presentation")
              button#tab-composition-btn.nav-link(
                data-bs-toggle="tab"
                data-bs-target="#tab-composition"
                type="button"
                role="tab"
                aria-controls="tab-composition"
                aria-selected="false"
                ) #{t("tabComposition")}
          if hasStorage
            li.nav-item(role="presentation")
              button#tab-storage-btn.nav-link(
                data-bs-toggle="tab"
                data-bs-target="#tab-storage"
                type="button"
                role="tab"
                aria-controls="tab-storage"
                aria-selected="false"
                ) #{t("tabStorage")}
          if hasInfo
            li.nav-item(role="presentation")
              button#tab-info-btn.nav-link(
                data-bs-toggle="tab"
                data-bs-target="#tab-info"
                type="button"
                role="tab"
                aria-controls="tab-info"
                aria-selected="false"
                ) #{t("tabInfo")}

        div.tab-content
          #tab-description.tab-pane.fade.show.active(
            role="tabpanel"
            aria-labelledby="tab-description-btn"
            tabindex="0"
            )
            if product.content
              div(class="sf-content") !{product.content}
            else if product.description
              div(class="sf-content") !{product.description}
            else
              p(class="sf-muted") #{t("noInfo")}

          if hasComposition
            #tab-composition.tab-pane.fade(
              role="tabpanel"
              aria-labelledby="tab-composition-btn"
              tabindex="0"
              )
              if product.ingredients
                h4 #{t("ingredients")}
                p(class="sf-pre-line") #{product.ingredients}
              if allergenList.length > 0
                h4 #{t("allergens")}
                div(class="sf-chip-list")
                  each item in allergenList
                    span(class="sf-chip sf-chip-warning") #{item}
              if hasNutrition
                h4 #{t("nutrition")}
                table(class="sf-info-table sf-nutrition-table")
                  tbody
                    if product.calories !== null && product.calories !== undefined
                      tr
                        th #{t("calories")}
                        td #{formatNumber(product.calories)} #{t("kcal")}
                    if product.protein !== null && product.protein !== undefined
                      tr
                        th #{t("protein")}
                        td #{formatNumber(product.protein)} #{t("gram")}
                    if product.fat !== null && product.fat !== undefined
                      tr
                        th #{t("fat")}
                        td #{formatNumber(product.fat)} #{t("gram")}
                    if product.carbohydrate !== null && product.carbohydrate !== undefined
                      tr
                        th #{t("carbohydrate")}
                        td #{formatNumber(product.carbohydrate)} #{t("gram")}

          if hasStorage
            #tab-storage.tab-pane.fade(
              role="tabpanel"
              aria-labelledby="tab-storage-btn"
              tabindex="0"
              )
              table(class="sf-info-table")
                tbody
                  +infoRow(t("storage"), storageName)
                  +infoRow(t("shelfLife"), shelfLifeText)
              if product.storageNote
                h4 #{t("storageNote")}
                p(class="sf-pre-line") #{product.storageNote}
              if product.usageInstructions
                h4 #{t("usageInstructions")}
                p(class="sf-pre-line") #{product.usageInstructions}

          if hasInfo
            #tab-info.tab-pane.fade(
              role="tabpanel"
              aria-labelledby="tab-info-btn"
              tabindex="0"
              )
              table(class="sf-info-table")
                tbody
                  +infoRow(t("brand"), product.brand)
                  +infoRow(t("origin"), originName)
                  +infoRow(t("manufacturer"), product.manufacturer)
                  +infoRow(t("importer"), product.importer)
                  +infoRow(t("certificate"), product.certificateNumber)
                  +infoRow(t("barcode"), product.barcode)
                  +infoRow(t("marking"), product.markingRequired ? t("yes") : "")

      //- Đánh giá của khách (giống Wildberries): tổng quan + ảnh của khách ở trên, bộ lọc, các thẻ đánh giá trong slider ngang
      //- main.js: lọc / sắp xếp tải lại slider từ /review/product/:id, kéo tới cuối slider tự tải thêm,
      //- "Читать полностью" tải toàn bộ 1 đánh giá từ /review/item/:id
      - const hasCustomerPhotos = reviewSummary.photoList.length > 0
      section(
        class="sf-reviews"
        id="reviews"
        review-section
        data-url=`/review/product/${product.id}`
        data-item-url="/review/item/"
        data-login-text=t("loginAction")
        )
        div(class="sf-section-heading")
          div
            h2
              | #{t("reviewsTitle")}
              if product.reviewCount > 0
                span(class="sf-reviews-count") #{formatNumber(product.reviewCount)}

        div(class="sf-review-overview" + (hasCustomerPhotos ? " has-photos" : ""))
          aside(class="sf-review-summary")
            if reviewSummary.total > 0
              div(class="sf-review-score")
                b #{formatNumber(product.rating)}
                div
                  +ratingStars(product.rating, "lg")
                  span #{tCount(reviewSummary.total, "ratingCount")}
              //- Bấm 1 dòng để lọc đánh giá theo số sao đó
              ul(class="sf-review-bars")
                each row in reviewSummary.distribution
                  li
                    button(
                      type="button"
                      review-filter-rating=row.star
                      disabled=row.count == 0 || !(product.reviewCount > 0)
                      aria-label=`${row.star} ${t("ratingOutOf")}: ${row.count}`
                      )
                      span(class="sf-review-bar-star")
                        | #{row.star}
                        i.fas.fa-star
                      span(class="sf-review-bar")
                        span(style=`width: ${row.percent}%`)
                      span(class="sf-review-bar-count") #{formatNumber(row.count)}
            else
              div(class="sf-review-none")
                +ratingStars(0, "lg")
                b #{t("reviewsNone")}
                p #{t("reviewsNoneText")}

            div(class="sf-review-action")
              if reviewAction && reviewAction.type == "write"
                a(
                  href=reviewAction.url
                  class="sf-btn sf-btn-primary sf-review-write-btn"
                  )
                  i.fas.fa-pen
                  | #{t("reviewWriteButton")}
              else if reviewAction && reviewAction.type == "edit"
                a(
                  href=reviewAction.url
                  class="sf-btn sf-btn-outline sf-review-write-btn"
                  )
                  i.fas.fa-user-check
                  | #{t("reviewYours")}
                  if reviewAction.statusName
                    small · #{reviewAction.statusName}
              else
                p(class="sf-review-buyers-note")
                  i.fas.fa-info-circle
                  | #{t("reviewOnlyBuyers")}

          //- Ảnh của khách (bấm để xem lớn, xem nối tiếp các ảnh)
          if hasCustomerPhotos
            div(class="sf-review-gallery")
              h3 #{t("reviewCustomerPhotos")}
                span #{formatNumber(reviewSummary.photoReviewCount)}
              ul(data-gallery-list=JSON.stringify(reviewSummary.photoList.map(photo => mediaUrl(photo.path))))
                each photo, index in reviewSummary.photoList
                  li
                    button(
                      type="button"
                      review-photo
                      data-index=index
                      aria-label=`${t("reviewPhoto")} ${index + 1}`
                      )
                      img(
                        src=mediaUrl(photo.path)
                        alt=""
                        loading="lazy"
                        )

        if product.reviewCount > 0
          //- Bộ lọc, sắp xếp
          div(class="sf-review-toolbar")
            div(
              class="sf-chip-list"
              role="group"
              )
              button(
                type="button"
                class="sf-chip active"
                review-filter-rating=""
                aria-pressed="true"
                ) #{t("reviewFilterAll")}
              if reviewSummary.photoReviewCount > 0
                button(
                  type="button"
                  class="sf-chip"
                  review-filter-photo
                  aria-pressed="false"
                  )
                  i.fas.fa-camera
                  | #{t("reviewFilterPhoto")}
              each star in [5, 4, 3, 2, 1]
                - const starRow = reviewSummary.distribution.find(row => row.star == star)
                if starRow && starRow.count > 0
                  button(
                    type="button"
                    class="sf-chip"
                    review-filter-rating=star
                    aria-pressed="false"
                    )
                    | #{star}
                    i.fas.fa-star
            label(class="sf-review-sort")
              span #{t("reviewSortLabel")}
              select(review-sort)
                each item in reviewSortList
                  option(value=item.id) #{t(item.key)}

          //- Slider ngang: vuốt trên điện thoại, mũi tên ‹ › trên máy tính
          div(class="sf-review-slider")
            button(
              type="button"
              class="sf-slider-arrow is-prev"
              review-prev
              aria-label=t("previous")
              disabled
              )
              i.fas.fa-chevron-left
            div(
              class="sf-review-track"
              review-list
              tabindex="0"
              role="region"
              aria-label=t("reviewsTitle")
              aria-live="polite"
              )
              include ../partials/review-list.pug
            button(
              type="button"
              class="sf-slider-arrow is-next"
              review-next
              aria-label=t("next")
              )
              i.fas.fa-chevron-right

        //- Cửa sổ đọc toàn bộ 1 đánh giá ("Читать полностью"), main.js tải nội dung khi bấm
        div(
          class="sf-review-modal"
          review-modal
          role="dialog"
          aria-modal="true"
          aria-label=t("reviewsTitle")
          hidden
          )
          div(class="sf-review-modal-box")
            button(
              type="button"
              class="sf-review-modal-close"
              review-modal-close
              aria-label=t("close")
              )
              i.fas.fa-times
            div(
              class="sf-review-modal-body"
              review-modal-body
              )

      //- Xem ảnh lớn (ảnh của khách trong đánh giá): main.js điền ảnh, bấm ‹ › để xem ảnh khác
      div(
        class="sf-lightbox"
        review-lightbox
        role="dialog"
        aria-modal="true"
        aria-label=t("reviewPhoto")
        hidden
        )
        button(
          type="button"
          class="sf-lightbox-close"
          lightbox-close
          aria-label=t("close")
          )
          i.fas.fa-times
        button(
          type="button"
          class="sf-lightbox-nav is-prev"
          lightbox-prev
          aria-label=t("previous")
          )
          i.fas.fa-chevron-left
        img(
          src=""
          alt=""
          lightbox-image
          )
        button(
          type="button"
          class="sf-lightbox-nav is-next"
          lightbox-next
          aria-label=t("next")
          )
          i.fas.fa-chevron-right
        span(
          class="sf-lightbox-counter"
          lightbox-counter
          )

      //- Sản phẩm tương tự
      if relatedList.length > 0
        div(class="sf-related")
          div(class="sf-section-heading")
            div
              h2 #{t("relatedProducts")}
          div(class="sf-product-grid sf-product-grid-home")
            each item in relatedList
              +productCard(item)
