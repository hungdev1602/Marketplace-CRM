extends ../layouts/default.pug
include ../mixins/form-field.pug

block main
  section(class="sf-section sf-section-first sf-auth-page")
    .container
      div(class="sf-auth sf-auth-single")
        div(class="sf-auth-card")
          span(class="sf-auth-icon")
            i.fas.fa-key
          h1 #{t("forgotPasswordTitle")}
          p(class="sf-auth-sub") #{t("forgotPasswordSub")}
          //- main.js gửi form bằng fetch (JSON), server luôn trả lời "đã gửi" (không cho biết có tài khoản hay không)
          //- Khách nhập email hoặc số điện thoại, link luôn gửi vào email của tài khoản
          form(
            action="/account/forgot-password"
            method="POST"
            account-form
            novalidate
            )
            +formField("login", t("loginId"), "text", { autocomplete: "username", maxlength: 100 })
            +formMessage()
            button(
              type="submit"
              class="sf-btn sf-btn-primary sf-auth-submit"
              ) #{t("sendResetLink")}
          p(class="sf-auth-switch")
            | #{t("rememberedPassword")}
            a(href="/account/login") #{t("loginAction")}
