extends ../layouts/default.pug
include ../mixins/form-field.pug
include ../mixins/account-benefits.pug
include ../mixins/google-button.pug

block main
  section(class="sf-section sf-section-first sf-auth-page")
    .container
      div(class="sf-auth")
        div(class="sf-auth-card")
          h1 #{t("register")}
          p(class="sf-auth-sub") #{t("registerSub")}
          form(
            action="/account/register"
            method="POST"
            account-form
            novalidate
            )
            input(
              type="hidden"
              name="next"
              value=next
              )
            +formField("fullName", t("fullName"), "text", { autocomplete: "name", maxlength: 60 })
            +formField("email", t("email"), "email", { autocomplete: "email", inputmode: "email", maxlength: 100 })
            +formField("phone", t("phone"), "tel", { autocomplete: "tel", inputmode: "tel", maxlength: 20, optional: true })
            +formField("password", t("password"), "password", { autocomplete: "new-password", maxlength: 72, hint: t("passwordHint") })
            +formField("confirmPassword", t("confirmPassword"), "password", { autocomplete: "new-password", maxlength: 72 })
            //- Đồng ý xử lý dữ liệu cá nhân: bắt buộc theo luật 152-ФЗ của Nga
            div(class="form-check sf-check")
              input.form-check-input(
                type="checkbox"
                id="field-agree"
                name="agree"
                )
              label.form-check-label(for="field-agree") #{t("agreeText")}
            +formMessage()
            button(
              type="submit"
              class="sf-btn sf-btn-primary sf-auth-submit"
              ) #{t("registerAction")}
          +googleButton(next)
          p(class="sf-auth-switch")
            | #{t("haveAccount")}
            a(href="/account/login" + (next ? `?next=${encodeURIComponent(next)}` : "")) #{t("loginAction")}
        +accountBenefits()
