extends ../layouts/default.pug
include ../mixins/product-card.pug
include ../mixins/section-heading.pug
include ../mixins/article-card.pug

//- Lưới sản phẩm dùng chung cho các mục của trang chủ
mixin productGrid(productList)
  div(class="sf-product-grid sf-product-grid-home")
    each product in productList
      +productCard(product)

block main
  //- Banner đầu trang
  section(class="sf-hero")
    .container
      div(class="sf-hero-inner")
        div(class="sf-hero-text")
          span(class="sf-hero-label") #{t("heroLabel")}
          h1 #{t("heroTitle")}
          p #{t("heroText")}
          div(class="sf-hero-buttons")
            a(
              href="/products"
              class="sf-btn sf-btn-dark"
              )
              | #{t("heroButton")}
              i.fas.fa-arrow-right
            if saleList.length > 0
              a(
                href="/products?onSale=1"
                class="sf-btn sf-btn-light"
                )
                i.fas.fa-tags
                | #{t("sale")}
          if stats.product > 0
            ul(class="sf-hero-stats")
              li
                b #{formatNumber(stats.product)}
                span #{tWord(stats.product, "productCount")}
              if stats.category > 0
                li
                  b #{formatNumber(stats.category)}
                  span #{tWord(stats.category, "categoryCount")}
              if stats.country > 0
                li
                  b #{formatNumber(stats.country)}
                  span #{tWord(stats.country, "countryCount")}
        div(class="sf-hero-visual" + (heroProductList.length > 0 ? "" : " is-empty"))
          if heroProductList.length > 0
            each product, index in heroProductList
              a(
                href=`/product/${product.slug}`
                class=`sf-hero-product sf-hero-product-${index + 1}`
                title=tName(product)
                )
                img(
                  src=mediaUrl(product.cardImage)
                  alt=tName(product)
                  )
                if product.discountPercent
                  span(class="sf-badge sf-badge-sale") −#{product.discountPercent}%
          else
            img(
              src="/client/assets/images/sfoodie-logo.png"
              alt="SFoodie"
              class="sf-hero-logo"
              )

  //- Danh mục sản phẩm
  if categoryTree.length > 0
    section(class="sf-section")
      .container
        +sectionHeading(t("sectionCategories"), t("sectionCategoriesSub"), "/categories")
        div(class="sf-category-grid")
          each item in categoryTree.slice(0, 12)
            a(
              href=`/category/${item.slug}`
              class="sf-category-card"
              )
              span(class="sf-category-img")
                if item.avatar
                  img(
                    src=mediaUrl(item.avatar)
                    alt=tName(item)
                    loading="lazy"
                    )
                else
                  i.fas.fa-utensils
              span(class="sf-category-name") #{tName(item)}

  if featuredList.length > 0
    section(class="sf-section")
      .container
        +sectionHeading(t("sectionFeatured"), t("sectionFeaturedSub"), "/products")
        +productGrid(featuredList)

  if saleList.length > 0
    section(class="sf-section sf-section-tint")
      .container
        +sectionHeading(t("sectionSale"), t("sectionSaleSub"), "/products?onSale=1")
        +productGrid(saleList)

  if newList.length > 0
    section(class="sf-section")
      .container
        +sectionHeading(t("sectionNew"), t("sectionNewSub"), "/products?sort=newest")
        +productGrid(newList)

  //- Mua theo xuất xứ
  if originList.length > 0
    section(class="sf-section sf-section-tint")
      .container
        +sectionHeading(t("sectionOrigin"), t("sectionOriginSub"))
        div(class="sf-origin-grid")
          each origin in originList
            a(
              href=`/products?origin=${origin.id}`
              class="sf-origin-card"
              )
              span(class="sf-origin-code") #{origin.id}
              span(class="sf-origin-text")
                b #{tName(origin)}
                span #{tCount(origin.total, "productCount")}

  if bestSellerList.length > 0
    section(class="sf-section")
      .container
        +sectionHeading(t("sectionBestSeller"), t("sectionBestSellerSub"), "/products?sort=best-seller")
        +productGrid(bestSellerList)

  //- Cửa hàng chưa có sản phẩm nào
  if stats.product == 0
    section(class="sf-section")
      .container
        div(class="sf-empty")
          i.fas.fa-box-open
          h3 #{t("emptyShopTitle")}
          p #{t("emptyShopText")}

  if articleList.length > 0
    section(class="sf-section sf-section-tint")
      .container
        +sectionHeading(t("sectionBlog"), t("sectionBlogSub"), "/blog")
        div(class="sf-article-grid")
          each article in articleList
            +articleCard(article)
