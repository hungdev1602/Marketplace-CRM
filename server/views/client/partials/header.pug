include ../mixins/search-box.pug

//- Nút đổi giao diện sáng / tối (main.js xử lý khi bấm)
mixin themeToggle()
  button(
    type="button"
    class="sf-theme-toggle"
    theme-toggle
    aria-label=t("themeToggle")
    title=t("themeToggle")
    )
    i.fas.fa-moon
    i.fas.fa-sun

//- Biểu tượng ♡ (yêu thích) và giỏ hàng kèm số lượng (main.js cập nhật số khi khách thêm / bỏ sản phẩm)
//- Dùng ở đầu trang trên điện thoại và ở menu trên máy tính (main-menu.pug)
mixin shopIconLinks()
  - const countText = (count) => count > 99 ? "99+" : `${count}`
  a(
    href="/wishlist"
    class="sf-icon-link" + (currentPath == "/wishlist" ? " active" : "")
    aria-label=t("wishlist")
    title=t("wishlist")
    )
    i.far.fa-heart
    span(class="sf-icon-text") #{t("wishlist")}
    span(
      class="sf-count"
      wishlist-count
      hidden=!(wishlistCount > 0)
      ) #{countText(wishlistCount)}
  a(
    href="/cart"
    class="sf-icon-link" + (currentPath == "/cart" ? " active" : "")
    aria-label=t("cart")
    title=t("cart")
    )
    i.fas.fa-shopping-basket
    span(class="sf-icon-text") #{t("cart")}
    span(
      class="sf-count"
      cart-count
      hidden=!(cartQuantity > 0)
      ) #{countText(cartQuantity)}

//- Nút tài khoản: chưa đăng nhập => "Войти" (trang đăng nhập)
//- Đã đăng nhập => tên khách, bấm vào mở menu nhỏ: "Личный кабинет", "Выйти" (main.js mở / đóng menu)
mixin accountLink()
  if clientAccount
    div(
      class="sf-account-menu"
      account-menu
      )
      button(
        type="button"
        class="sf-icon-link sf-account-link sf-account-toggle" + (currentPath.startsWith("/account") ? " active" : "")
        account-menu-toggle
        aria-label=t("myAccount")
        title=t("myAccount")
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="sf-account-dropdown"
        )
        i.fas.fa-user
        span(class="sf-icon-text") #{(clientAccount.fullName || "").split(" ")[0]}
        i(class="fas fa-chevron-down sf-account-caret")
      div(
        class="sf-account-dropdown"
        id="sf-account-dropdown"
        account-menu-panel
        hidden
        )
        div(class="sf-account-dropdown-head")
          b #{clientAccount.fullName}
          span #{clientAccount.email}
        a(
          href="/account"
          class="sf-account-dropdown-item"
          )
          i.fas.fa-user-circle
          span #{t("myAccount")}
        a(
          href="/account/orders"
          class="sf-account-dropdown-item"
          )
          i.fas.fa-receipt
          span #{t("myOrders")}
        a(
          href="/account/reviews"
          class="sf-account-dropdown-item"
          )
          i.far.fa-star
          span #{t("myReviews")}
        //- Đăng xuất phải gửi bằng form POST (không dùng link), để trang web khác không đăng xuất được khách
        form(
          action="/account/logout"
          method="POST"
          )
          button(
            type="submit"
            class="sf-account-dropdown-item is-logout"
            )
            i.fas.fa-sign-out-alt
            span #{t("logout")}
  else
    a(
      href="/account/login"
      class="sf-icon-link sf-account-link" + (currentPath.startsWith("/account") ? " active" : "")
      aria-label=t("loginOrRegister")
      title=t("loginOrRegister")
      )
      i.far.fa-user
      span(class="sf-icon-text") #{t("loginAction")}

header(class="header_2 sf-header")
  .container
    .row.align-items-center
      .col-lg-2.col-xl-2
        div(class="header_logo_area")
          a(
            class="header_logo"
            href="/"
            )
            img.img-fluid(
              alt="SFoodie Asian Store"
              src="/client/assets/images/sfoodie-logo.png"
              width="480"
              height="118"
              )
          div(class="sf-header-mobile-actions d-flex d-lg-none")
            +shopIconLinks()
            +themeToggle()
            button(
              aria-controls="offcanvasWithBothOptions"
              data-bs-target="#offcanvasWithBothOptions"
              data-bs-toggle="offcanvas"
              class="mobile_menu_icon"
              type="button"
              aria-label=t("menu")
              )
              i.fas.fa-bars(class="menu_icon_bar")
      //- Tìm kiếm: máy tính ở giữa đầu trang, điện thoại là 1 hàng riêng dưới logo
      .col-12.col-lg-6.col-xl-6(class="sf-header-search")
        +searchBox()
      .col-xl-4.col-lg-4.d-none.d-lg-flex.justify-content-end.align-items-center.gap-3
        if shopInfo.phone
          div(class="sf-header-phone")
            span.icon
              i.fas.fa-phone-alt
            div
              span #{t("hotline")}
              a(href=`tel:${shopInfo.phone.replace(/[^\d+]/g, "")}`) #{shopInfo.phone}
        +themeToggle()
        //- Chọn ngôn ngữ
        ul(
          class="sf-language"
          aria-label=t("language")
          )
          each item in languageList
            li
              a(
                href=`/language/${item.id}`
                class=(item.id == lang ? "active" : "")
                title=item.name
                hreflang=item.id
                ) #{item.shortName}
