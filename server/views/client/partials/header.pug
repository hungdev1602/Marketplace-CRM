//- Nút đổi giao diện sáng / tối (main.js xử lý khi bấm)
mixin themeToggle()
  button(
    type="button"
    class="sf-theme-toggle"
    theme-toggle
    aria-label=t("themeToggle")
    title=t("themeToggle")
    )
    i.fas.fa-moon
    i.fas.fa-sun

header(class="header_2 sf-header")
  .container
    .row.align-items-center
      .col-lg-2.col-xl-2
        div(class="header_logo_area")
          a(
            class="header_logo"
            href="/"
            )
            img.img-fluid(
              alt="SFoodie Asian Store"
              src="/client/assets/images/sfoodie-logo.png"
              width="480"
              height="118"
              )
          div(class="sf-header-mobile-actions d-flex d-lg-none")
            +themeToggle()
            button(
              aria-controls="offcanvasWithBothOptions"
              data-bs-target="#offcanvasWithBothOptions"
              data-bs-toggle="offcanvas"
              class="mobile_menu_icon"
              type="button"
              aria-label=t("menu")
              )
              i.fas.fa-bars(class="menu_icon_bar")
      .col-xl-6.col-lg-6.d-none.d-lg-block
        //- Tìm kiếm: chọn danh mục (không bắt buộc) + từ khoá
        form(
          action="/products"
          method="GET"
          class="sf-search"
          )
          select(
            name="category"
            class="sf-search-select"
            aria-label=t("categories")
            )
            option(value="") #{t("allCategories")}
            each item in categoryTree
              option(
                value=item.slug
                selected=(item.slug == (query && query.category))
                ) #{tName(item)}
              each child in item.children
                option(
                  value=child.slug
                  selected=(child.slug == (query && query.category))
                  ) — #{tName(child)}
          .sf-search-input
            input(
              placeholder=t("searchPlaceholder")
              type="search"
              name="keyword"
              value=(query && query.keyword) || ""
              aria-label=t("searchPlaceholder")
              )
            button(
              type="submit"
              aria-label=t("search")
              )
              i.fas.fa-search
      .col-xl-4.col-lg-4.d-none.d-lg-flex.justify-content-end.align-items-center.gap-3
        if shopInfo.phone
          div(class="sf-header-phone")
            span.icon
              i.fas.fa-phone-alt
            div
              span #{t("hotline")}
              a(href=`tel:${shopInfo.phone.replace(/[^\d+]/g, "")}`) #{shopInfo.phone}
        +themeToggle()
        //- Chọn ngôn ngữ
        ul(
          class="sf-language"
          aria-label=t("language")
          )
          each item in languageList
            li
              a(
                href=`/language/${item.id}`
                class=(item.id == lang ? "active" : "")
                title=item.name
                hreflang=item.id
                ) #{item.shortName}
