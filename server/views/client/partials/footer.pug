footer(class="sf-footer")
  .container
    .row.gy-4
      .col-xl-4.col-lg-4.col-md-12
        a(
          href="/"
          class="sf-footer-logo"
          )
          img.img-fluid(
            alt="SFoodie Asian Store"
            src="/client/assets/images/sfoodie-logo.png"
            width="480"
            height="118"
            loading="lazy"
            )
        p(class="sf-footer-about") #{t("footerAbout")}
        if shopInfo.telegram || shopInfo.whatsapp || shopInfo.vk
          ul(class="sf-footer-social")
            if shopInfo.telegram
              li
                a(
                  href=shopInfo.telegram
                  target="_blank"
                  rel="noopener"
                  aria-label="Telegram"
                  )
                  i.fab.fa-telegram-plane
            if shopInfo.whatsapp
              li
                a(
                  href=shopInfo.whatsapp
                  target="_blank"
                  rel="noopener"
                  aria-label="WhatsApp"
                  )
                  i.fab.fa-whatsapp
            if shopInfo.vk
              li
                a(
                  href=shopInfo.vk
                  target="_blank"
                  rel="noopener"
                  aria-label="VK"
                  )
                  i.fab.fa-vk
      .col-xl-3.col-lg-3.col-md-4.col-sm-6
        h3 #{t("footerCatalog")}
        ul(class="sf-footer-links")
          each item in categoryTree.slice(0, 6)
            li
              a(href=`/category/${item.slug}`) #{tName(item)}
          li
            a(href="/categories") #{t("allCategories")}
      .col-xl-2.col-lg-2.col-md-4.col-sm-6
        h3 #{t("footerCustomers")}
        ul(class="sf-footer-links")
          li
            a(href="/products") #{t("products")}
          li
            a(href="/products?onSale=1") #{t("sale")}
          li
            a(href="/products?sort=newest") #{t("newArrivals")}
          li
            a(href="/blog") #{t("blog")}
      .col-xl-3.col-lg-3.col-md-4
        h3 #{t("footerContact")}
        ul(class="sf-footer-contact")
          if shopInfo.phone
            li
              i.fas.fa-phone-alt
              a(href=`tel:${shopInfo.phone.replace(/[^\d+]/g, "")}`) #{shopInfo.phone}
          if shopInfo.email
            li
              i.fas.fa-envelope
              a(href=`mailto:${shopInfo.email}`) #{shopInfo.email}
          if shopInfo.address
            li
              i.fas.fa-map-marker-alt
              span #{shopInfo.address}
          if shopInfo.workingHours
            li
              i.fas.fa-clock
              span #{t("workingHours")}: #{shopInfo.workingHours}
          li
            i.fas.fa-globe
            span
              each item, index in languageList
                if index > 0
                  | &nbsp;·&nbsp;
                a(
                  href=`/language/${item.id}`
                  class=(item.id == lang ? "active" : "")
                  hreflang=item.id
                  ) #{item.name}
    div(class="sf-footer-bottom")
      p © #{currentYear} SFoodie Asian Store. #{t("copyright")}
