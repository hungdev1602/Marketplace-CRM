include ../mixins/review-item.pug

//- Các thẻ đánh giá trong slider ngang ở trang sản phẩm
//- - Lần đầu: include trong pages/product-detail.pug
//- - Lọc, sắp xếp, tải thêm: GET /review/product/:id trả về file này, main.js chèn vào slider
//- Dữ liệu: reviewViewList, reviewResult ({ total, page, hasMore }), reviewFilter
each view in reviewViewList
  +reviewCard(view)

if reviewResult.page == 1 && reviewResult.total == 0
  p(class="sf-review-empty-filter") #{t("reviewFilterEmpty")}

//- Ô cuối slider: khách kéo / bấm mũi tên tới đây thì main.js tự tải thêm (bấm nút cũng được)
if reviewResult.hasMore
  div(
    class="sf-review-more"
    review-more
    )
    button(
      type="button"
      class="sf-btn sf-btn-outline"
      data-page=reviewResult.page + 1
      review-more-button
      )
      i.fas.fa-spinner.fa-spin
      span #{t("reviewShowMore")}
