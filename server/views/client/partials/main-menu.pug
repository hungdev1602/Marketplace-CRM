//- Mục menu đang xem được tô đậm
- const isActive = (path) => path === "/" ? currentPath === "/" : currentPath.startsWith(path)
- const isOnSale = query && query.onSale === "1"

nav.d-none.d-lg-block(class="main_menu_2 main_menu")
  .container
    .row
      .col-12.d-flex.flex-wrap
        div(class="main_menu_area")
          div(class="menu_category_area")
            a.d-none(
              class="menu_logo"
              href="/"
              )
              img.img-fluid(
                alt="SFoodie"
                src="/client/assets/images/sfoodie-logo.png"
                width="480"
                height="118"
                )
            //- Danh mục sản phẩm (admin tạo ở trang Quản lý danh mục sản phẩm)
            div(class="menu_category_bar")
              p
                span
                  i.fas.fa-th-large
                | #{t("browseCategories")}
              i.fas.fa-chevron-down
            ul(class="menu_cat_item")
              each item in categoryTree.slice(0, 10)
                li
                  a(href=`/category/${item.slug}`)
                    span
                      if item.avatar
                        img(
                          alt=tName(item)
                          src=mediaUrl(item.avatar)
                          loading="lazy"
                          )
                      else
                        i.fas.fa-utensils
                    | #{tName(item)}
                  if item.children.length > 0
                    ul(class="menu_cat_droapdown")
                      each child in item.children
                        li
                          a(href=`/category/${child.slug}`)
                            | #{tName(child)}
                            if child.children.length > 0
                              i.fas.fa-angle-right
                          if child.children.length > 0
                            ul(class="sub_category")
                              each grandChild in child.children
                                li
                                  a(href=`/category/${grandChild.slug}`) #{tName(grandChild)}
              li(class="all_category")
                a(href="/categories")
                  | #{t("allCategories")}
                  i.fas.fa-arrow-right
          ul(class="menu_item")
            li
              a(
                href="/"
                class=isActive("/") ? "active" : ""
                ) #{t("home")}
            li
              a(
                href="/products"
                class=(isActive("/products") && !isOnSale) || isActive("/category") || isActive("/product/") ? "active" : ""
                ) #{t("products")}
            li
              a(
                href="/products?onSale=1"
                class=isOnSale ? "active" : ""
                ) #{t("sale")}
            li
              a(href="/products?sort=newest") #{t("newArrivals")}
            li
              a(
                href="/categories"
                class=isActive("/categories") ? "active" : ""
                ) #{t("categories")}
            li
              a(
                href="/blog"
                class=isActive("/blog") ? "active" : ""
                ) #{t("blog")}
