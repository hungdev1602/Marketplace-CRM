//- Menu trên điện thoại (bấm nút ☰ ở đầu trang)
div(class="mobile_menu_area")
  #offcanvasWithBothOptions.offcanvas.offcanvas-start(
    tabindex="-1"
    data-bs-scroll="true"
    )
    button.btn-close(
      aria-label=t("close")
      data-bs-dismiss="offcanvas"
      type="button"
      )
      i.fas.fa-times
    .offcanvas-body
      a(
        href="/"
        class="sf-mobile-logo"
        )
        img.img-fluid(
          alt="SFoodie"
          src="/client/assets/images/sfoodie-logo.png"
          width="480"
          height="118"
          )
      ul(
        class="sf-language sf-language-mobile"
        aria-label=t("language")
        )
        each item in languageList
          li
            a(
              href=`/language/${item.id}`
              class=(item.id == lang ? "active" : "")
              hreflang=item.id
              ) #{item.name}
      form(
        class="mobile_menu_search"
        action="/products"
        method="GET"
        )
        input(
          placeholder=t("searchPlaceholder")
          type="search"
          name="keyword"
          value=(query && query.keyword) || ""
          aria-label=t("searchPlaceholder")
          )
        button(
          type="submit"
          aria-label=t("search")
          )
          i.fas.fa-search
      div(class="mobile_menu_item_area")
        ul#pills-tab.nav.nav-pills(role="tablist")
          li.nav-item(role="presentation")
            button#pills-home-tab.nav-link.active(
              aria-selected="true"
              aria-controls="pills-home"
              role="tab"
              type="button"
              data-bs-target="#pills-home"
              data-bs-toggle="pill"
              ) #{t("categories")}
          li.nav-item(role="presentation")
            button#pills-profile-tab.nav-link(
              aria-selected="false"
              aria-controls="pills-profile"
              role="tab"
              type="button"
              data-bs-target="#pills-profile"
              data-bs-toggle="pill"
              ) #{t("menu")}
        #pills-tabContent.tab-content
          #pills-home.tab-pane.fade.show.active(
            tabindex="0"
            aria-labelledby="pills-home-tab"
            role="tabpanel"
            )
            ul(class="main_mobile_menu")
              each item in categoryTree
                if item.children.length > 0
                  li(class="mobile_dropdown")
                    a(href="#") #{tName(item)}
                    ul(class="inner_menu")
                      li
                        a(href=`/category/${item.slug}`) #{t("viewAll")}
                      each child in item.children
                        li
                          a(href=`/category/${child.slug}`) #{tName(child)}
                else
                  li
                    a(href=`/category/${item.slug}`) #{tName(item)}
              li
                a(href="/categories") #{t("allCategories")}
          #pills-profile.tab-pane.fade(
            tabindex="0"
            aria-labelledby="pills-profile-tab"
            role="tabpanel"
            )
            ul(class="main_mobile_menu")
              li
                a(href="/") #{t("home")}
              li
                a(href="/products") #{t("products")}
              li
                a(href="/products?onSale=1") #{t("sale")}
              li
                a(href="/products?sort=newest") #{t("newArrivals")}
              li
                a(href="/categories") #{t("categories")}
              li
                a(href="/blog") #{t("blog")}
      if shopInfo.phone
        a(
          href=`tel:${shopInfo.phone.replace(/[^\d+]/g, "")}`
          class="sf-mobile-phone"
          )
          i.fas.fa-phone-alt
          | #{shopInfo.phone}
