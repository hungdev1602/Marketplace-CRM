//- Email đơn hàng gửi cho khách (helpers/order.helper.ts: sendOrderPaidEmails, sendOrderShippedEmail)
//- - type "paid": đã nhận thanh toán, type "shipped": đã giao cho hãng vận chuyển (kèm mã vận đơn)
//- Email không dùng được file CSS: viết style ngay trong thẻ, bố cục bằng bảng (table)
- const delivery = order.delivery
- const shipment = order.shipment || {}
doctype html
html(lang=lang)
  head
    meta(charset="UTF-8")
    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
      )
    title #{subject}
  body(style="margin:0;padding:0;background:#F1F7F8;font-family:Arial,Helvetica,sans-serif;color:#111417;")
    table(
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background:#F1F7F8;"
      )
      tr
        td(align="center" style="padding:32px 16px;")
          table(
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="max-width:560px;background:#FFFFFF;border:2px solid #111417;border-radius:20px;"
            )
            tr
              td(style="padding:24px 32px 0;font-size:24px;font-weight:bold;letter-spacing:1px;")
                span(style="color:#111417;") S
                span(style="color:#007A8C;") FOODIE
            tr
              td(style="padding:20px 32px 0;font-size:16px;line-height:1.6;")
                p(style="margin:0 0 12px;font-size:18px;font-weight:bold;") #{t("hello")}, #{order.customer.fullName}!
                p(style="margin:0 0 16px;") #{t(type == "paid" ? "orderEmailPaidText" : "orderEmailShippedText")}
                p(style="margin:0 0 16px;font-size:15px;")
                  | #{t("orderNumber")}:
                  b  #{order.code}
            if type == "shipped"
              tr
                td(style="padding:0 32px 8px;font-size:15px;line-height:1.6;")
                  p(style="margin:0 0 6px;") #{t("deliveryService")}: #{providerName}
                  if shipment.providerNumber
                    p(style="margin:0 0 6px;")
                      | #{t("trackingNumber")}:
                      b  #{shipment.providerNumber}
                  if shipment.trackingUrl
                    p(style="margin:12px 0 0;")
                      a(
                        href=shipment.trackingUrl
                        target="_blank"
                        style="display:inline-block;padding:12px 24px;border:2px solid #111417;border-radius:999px;background:#111417;color:#FFFFFF;font-size:15px;font-weight:bold;text-decoration:none;"
                        ) #{t("trackOrder")}
            else
              tr
                td(style="padding:0 32px;")
                  table(
                    role="presentation"
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    style="font-size:14px;line-height:1.5;border-top:1px solid #E1EBED;"
                    )
                    each item in order.items
                      tr
                        td(style="padding:8px 0;border-bottom:1px solid #E1EBED;") #{tName(item)} × #{item.quantity}
                        td(align="right" style="padding:8px 0 8px 12px;border-bottom:1px solid #E1EBED;white-space:nowrap;") #{formatPrice(item.lineTotal)}
                    if order.couponDiscount > 0
                      tr
                        td(style="padding:8px 0;color:#B42318;") #{t("coupon")} #{order.couponCode}
                        td(align="right" style="padding:8px 0 8px 12px;color:#B42318;white-space:nowrap;") −#{formatPrice(order.couponDiscount)}
                    tr
                      td(style="padding:8px 0;") #{t("delivery")} (#{providerName})
                      td(align="right" style="padding:8px 0 8px 12px;white-space:nowrap;") #{order.deliveryCost > 0 ? formatPrice(order.deliveryCost) : t("free")}
                    tr
                      td(style="padding:10px 0;font-size:16px;font-weight:bold;") #{t("total")}
                      td(align="right" style="padding:10px 0 10px 12px;font-size:16px;font-weight:bold;white-space:nowrap;") #{formatPrice(order.total)}
              tr
                td(style="padding:12px 32px 0;font-size:14px;line-height:1.6;color:#2A3337;")
                  if delivery.type == "point" && delivery.point
                    p(style="margin:0;") #{t("pickupPoint")}: #{delivery.point.address}
                  else
                    p(style="margin:0;") #{t("deliveryAddress")}: #{delivery.address}
            tr
              td(align="center" style="padding:24px 32px 0;")
                a(
                  href=orderUrl
                  target="_blank"
                  style="display:inline-block;padding:14px 28px;border:2px solid #111417;border-radius:999px;background:#02CAE5;color:#111417;font-size:16px;font-weight:bold;text-decoration:none;"
                  ) #{t("orderEmailButton")}
            tr
              td(style="padding:24px 32px;font-size:13px;color:#93A7AC;")
                | © SFoodie
