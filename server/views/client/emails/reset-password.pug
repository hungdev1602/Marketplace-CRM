//- Email đặt lại mật khẩu (gửi ở controller/client/account.controller.ts: forgotPasswordPost)
//- Email không dùng được file CSS: viết style ngay trong thẻ, bố cục bằng bảng (table) để hiện đúng trên Gmail, Яндекс Почта, Mail.ru, Outlook
//- - fullName: họ tên khách, resetLink: link đặt lại mật khẩu, expireText: "Ссылка действует 30 минут."
doctype html
html(lang=lang)
  head
    meta(charset="UTF-8")
    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
      )
    title #{t("resetEmailSubject")}
  body(style="margin:0;padding:0;background:#F1F7F8;font-family:Arial,Helvetica,sans-serif;color:#111417;")
    table(
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background:#F1F7F8;"
      )
      tr
        td(align="center" style="padding:32px 16px;")
          table(
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="max-width:520px;background:#FFFFFF;border:2px solid #111417;border-radius:20px;"
            )
            tr
              td(style="padding:24px 32px 0;font-size:24px;font-weight:bold;letter-spacing:1px;")
                span(style="color:#111417;") S
                span(style="color:#007A8C;") FOODIE
            tr
              td(style="padding:20px 32px 0;font-size:16px;line-height:1.6;")
                p(style="margin:0 0 12px;font-size:18px;font-weight:bold;") #{t("hello")}, #{fullName}!
                p(style="margin:0 0 24px;") #{t("resetEmailText")}
            tr
              td(align="center" style="padding:0 32px;")
                a(
                  href=resetLink
                  target="_blank"
                  style="display:inline-block;padding:14px 28px;border:2px solid #111417;border-radius:999px;background:#02CAE5;color:#111417;font-size:16px;font-weight:bold;text-decoration:none;"
                  ) #{t("resetEmailButton")}
            tr
              td(style="padding:24px 32px 0;font-size:14px;line-height:1.6;color:#5D6B70;")
                p(style="margin:0 0 12px;") #{expireText}
                p(style="margin:0 0 12px;") #{t("resetEmailIgnore")}
                p(style="margin:0 0 6px;") #{t("resetEmailLinkHint")}
                p(style="margin:0;word-break:break-all;")
                  a(
                    href=resetLink
                    target="_blank"
                    style="color:#007A8C;"
                    ) #{resetLink}
            tr
              td(style="padding:24px 32px;font-size:13px;color:#93A7AC;")
                | © SFoodie
