doctype html
html(lang=lang)
  head
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0"
      name="viewport"
      )
    title #{pageTitle}
    meta(
      name="description"
      content=metaDescription || t("siteDescription")
      )
    meta(
      name="theme-color"
      content="#02CAE5"
      )
    link(
      href="/client/assets/images/favicon.ico"
      rel="icon"
      )
    link(
      href="/client/assets/images/apple-touch-icon.png"
      rel="apple-touch-icon"
      )
    //- Tải trước font chữ tiếng Nga (ngôn ngữ mặc định) để chữ hiện đúng font ngay từ đầu
    link(
      href="/client/assets/fonts/nunito-cyrillic-wght-normal.woff2"
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      )
    link(
      href="/client/assets/css/all.min.css"
      rel="stylesheet"
      )
    link(
      href="/client/assets/css/bootstrap.min.css"
      rel="stylesheet"
      )
    link(
      href="/client/assets/css/mobile_menu.css"
      rel="stylesheet"
      )
    link(
      href="/client/assets/css/scroll_button.css"
      rel="stylesheet"
      )
    link(
      href="/client/assets/css/custom_spacing.css"
      rel="stylesheet"
      )
    link(
      href="/client/assets/css/style.css"
      rel="stylesheet"
      )
    link(
      href="/client/assets/css/responsive.css"
      rel="stylesheet"
      )
    //- Màu sắc, font chữ theo logo SFoodie (đặt cuối cùng để ghi đè giao diện mẫu)
    link(
      href="/client/assets/css/sfoodie.css"
      rel="stylesheet"
      )
  body(class="default_home sfoodie")
    include ../partials/header.pug
    include ../partials/main-menu.pug
    include ../partials/mobile-menu-area.pug

    main
      block main

    include ../partials/footer.pug
    include ../partials/scroll-button.pug

    // bootstrap js (menu mobile, tab ở trang chi tiết sản phẩm)
    script(src="/client/assets/js/bootstrap.bundle.min.js")
    // js của trang khách hàng
    script(src="/client/assets/js/main.js")
