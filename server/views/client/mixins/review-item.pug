include ./rating-stars.pug

//- 1 đánh giá ở trang sản phẩm (dữ liệu từ buildReviewView: controller/client/review.controller.ts)
//- Chữ của khách hiện bằng #{} (tự đổi ký tự HTML), xuống dòng giữ nguyên nhờ CSS white-space: pre-line
mixin reviewItem(view)
  - const review = view.review
  - const photoList = review.photos || []
  article(
    class="sf-review"
    id=`review-${review.id}`
    )
    div(class="sf-review-head")
      span(
        class="sf-review-avatar"
        aria-hidden="true"
        ) #{view.authorInitial}
      div(class="sf-review-author")
        b #{view.authorName}
        span
          | #{view.dateText}
          if review.editedAt
            |  · #{t("reviewEdited")}
      +ratingStars(review.rating, "sm")
    p(class="sf-review-verified")
      i.fas.fa-check-circle
      | #{t("reviewVerifiedBuyer")}

    if review.pros
      div(class="sf-review-block")
        h4 #{t("reviewPros")}
        p #{review.pros}
    if review.cons
      div(class="sf-review-block")
        h4 #{t("reviewCons")}
        p #{review.cons}
    if review.comment
      div(class="sf-review-block")
        h4 #{t("reviewComment")}
        p #{review.comment}

    //- Ảnh: bấm để xem lớn (main.js: [review-photo])
    if photoList.length > 0
      ul(class="sf-review-photos")
        each photo, index in photoList
          li
            button(
              type="button"
              review-photo=mediaUrl(photo)
              data-gallery=review.id
              aria-label=`${t("reviewPhoto")} ${index + 1}`
              )
              img(
                src=mediaUrl(photo)
                alt=""
                loading="lazy"
                )

    //- Cửa hàng trả lời
    if review.reply && review.reply.text
      div(class="sf-review-reply")
        div(class="sf-review-reply-head")
          b
            i.fas.fa-store
            | #{t("reviewShopReply")}
          if view.replyDateText
            span #{view.replyDateText}
        p #{review.reply.text}

    //- "Отзыв полезен?" (main.js: [review-vote])
    div(class="sf-review-foot")
      if view.isMine
        span(class="sf-review-mine")
          i.fas.fa-user-check
          | #{t("reviewYours")}
      else
        span #{t("reviewHelpfulQuestion")}
        button(
          type="button"
          class="sf-review-vote" + (view.myVote == 1 ? " is-active" : "")
          review-vote=review.id
          data-value="1"
          aria-pressed=view.myVote == 1 ? "true" : "false"
          )
          i.far.fa-thumbs-up
          span #{t("reviewHelpfulYes")}
          b(review-vote-count) #{review.helpfulCount > 0 ? review.helpfulCount : ""}
        button(
          type="button"
          class="sf-review-vote" + (view.myVote == -1 ? " is-active" : "")
          review-vote=review.id
          data-value="-1"
          aria-pressed=view.myVote == -1 ? "true" : "false"
          )
          i.far.fa-thumbs-down
          span #{t("reviewHelpfulNo")}
          b(review-vote-count) #{review.unhelpfulCount > 0 ? review.unhelpfulCount : ""}
