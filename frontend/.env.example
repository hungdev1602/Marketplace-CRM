# Copy file này thành file .env.local (cùng thư mục frontend) rồi sửa nếu cần
# File .env.local đã được .gitignore, không bị đẩy lên GitHub

# Địa chỉ server Express (thư mục server), không có dấu / ở cuối
# - Chạy trên máy: http://localhost:3000
# - Lên server thật: địa chỉ nội bộ của server Express, ví dụ http://127.0.0.1:3000
API_URL=http://localhost:3000
